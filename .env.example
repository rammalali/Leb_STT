# Whisper model id on Hugging Face. Downloaded once, then runs offline.
MODEL_ID=openai/whisper-large-v3-turbo

# "auto", "cuda", or "cpu".
DEVICE=auto

# Optional. Used only for the one-time model download (faster, no rate-limit
# warning). Required only if MODEL_ID points to a gated/private repo.
HF_TOKEN=

# Optional default language hint (e.g. "arabic", "english"). Empty = auto-detect.
TRANSCRIBE_LANGUAGE=arabic

# Optional default decoder prompt (vocabulary, names, style hints; ~224 tokens).
TRANSCRIBE_PROMPT=

# Default speaker count when num_speakers is not provided in a request.
# Pin to 2 for two-person dialogue. Empty = let the clusterer decide.
DEFAULT_NUM_SPEAKERS=2

# Server
HOST=0.0.0.0
PORT=8000
